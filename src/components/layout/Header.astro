---
import { nav, site, withBase } from '../../site';
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
const isCase = /\/casos\/[^/]+\/$/.test(path);
---

<header class="site-header" data-header>
  <div class="bar">
    <a class="brand" href={withBase('/')} aria-label={`${site.name}, inicio`}>
      <svg class="mark" viewBox="0 0 32 32" width="34" height="34" aria-hidden="true">
        <defs>
          <linearGradient id="brand-g" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="var(--primary)" /><stop offset="1" stop-color="var(--accent)" />
          </linearGradient>
        </defs>
        <rect width="32" height="32" rx="10" fill="url(#brand-g)" />
        <path d="M10.5 9v14M21.5 9v14" class="mark-stroke" stroke-width="3.2" />
        <path d="M10.5 19.5c4 0 6.5-5.5 11-5.5" class="mark-stroke" stroke-width="2.6" />
      </svg>
      <span class="brand-name">{site.name}</span>
    </a>

    <nav class="nav" aria-label="Principal">
      <div class="track" data-nav-list>
        <span class="indicator" aria-hidden="true" data-nav-indicator></span>
        <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href} data-spy-target={item.spy} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
        </ul>
      </div>
    </nav>

    <div class="actions">
      <button class="icon-btn theme-toggle" type="button" data-theme-toggle aria-label="Cambiar a tema oscuro">
        <svg class="i-sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        <svg class="i-moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
      </button>
      <a class="contact-cta" href={`mailto:${site.email}`}>Contactar</a>
      <button class="icon-btn menu-btn" type="button" data-menu-toggle aria-expanded="false" aria-controls="menu-panel" aria-label="Abrir menú">
        <span class="burger" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>

    {isCase && <span class="progress" aria-hidden="true"></span>}
  </div>

  <div class="menu-panel" id="menu-panel" data-menu-panel hidden>
    <ul>
      {nav.map((item) => (
        <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
      ))}
    </ul>
    <div class="menu-actions">
      <a class="btn btn-primary" href={`mailto:${site.email}`}>Escribirme un correo</a>
      <a class="btn btn-quiet" href={site.cv} download>{site.cvLabel}</a>
    </div>
  </div>
</header>
<script is:inline src={withBase('/js/nav.js')} defer></script>

<style>
  .site-header {
    position: sticky;
    top: var(--space-3);
    z-index: 50;
    width: min(100% - 2 * var(--space-3), 1220px);
    margin: var(--space-3) auto 0;
  }

  .bar {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-4);
    min-height: 64px;
    padding: var(--space-2) var(--space-2) var(--space-2) var(--space-4);
    border-radius: var(--radius-pill);
    background: color-mix(in oklab, var(--surface) 72%, transparent);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
    backdrop-filter: blur(18px) saturate(160%);
    border: 1px solid color-mix(in oklab, var(--border) 80%, transparent);
    transition: box-shadow var(--duration-base) var(--ease-out), background-color var(--duration-base) var(--ease-out);
  }
  /* Al bajar, la barra gana profundidad para separarse del contenido */
  [data-scrolled] .bar {
    background: color-mix(in oklab, var(--surface) 86%, transparent);
    box-shadow: var(--shadow-card), 0 0 0 1px color-mix(in oklab, var(--primary) 18%, transparent);
  }

  /* ---------- Marca ---------- */
  .brand { display: inline-flex; align-items: center; gap: var(--space-3); text-decoration: none; min-width: 0; justify-self: start; }
  .mark { flex: none; transition: transform var(--duration-base) var(--ease-spring); }
  .brand:hover .mark { transform: rotate(-8deg) scale(1.06); }
  .mark { border-radius: 10px; box-shadow: 0 4px 14px -4px color-mix(in oklab, var(--primary) 55%, transparent); }
  .mark-stroke { fill: none; stroke: #fff; stroke-linecap: round; }
  .brand-name {
    font-family: var(--font-display);
    font-size: 1.1875rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    font-variation-settings: 'opsz' 48, 'SOFT' 100;
    white-space: nowrap;
  }

  /* ---------- Navegación con indicador deslizante ---------- */
  .nav { display: none; }
  .track {
    position: relative;
    padding: 4px;
    border-radius: var(--radius-pill);
    background: color-mix(in oklab, var(--bg) 55%, transparent);
  }
  .nav ul { position: relative; display: flex; gap: var(--space-1); margin: 0; padding: 0; list-style: none; }
  .nav li { position: relative; z-index: 1; }
  .nav a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 var(--space-4);
    border-radius: var(--radius-pill);
    color: var(--text-muted);
    font-weight: 500;
    font-size: 0.9375rem;
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }
  .nav a:hover, .nav a.is-active, .nav a[aria-current='page'] { color: var(--text); }
  /* Sin JavaScript: fondo fijo en la página actual */
  .nav a[aria-current='page'] { background: var(--surface-raised); }
  .track[data-ready] a[aria-current='page'] { background: none; }

  .indicator {
    position: absolute;
    inset: 4px;
    z-index: 0;
    border-radius: var(--radius-pill);
    background: var(--surface-raised);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--primary) 35%, transparent);
    /* Se recorta al enlace activo: solo anima clip-path y opacity */
    clip-path: inset(0 calc(100% - var(--r, 0px)) 0 var(--l, 0px) round 999px);
    opacity: 0;
    transition: clip-path 320ms var(--ease-out), opacity var(--duration-fast) var(--ease-out);
    pointer-events: none;
  }
  .indicator::after {
    content: '';
    position: absolute;
    left: var(--l, 0px);
    width: calc(var(--r, 0px) - var(--l, 0px));
    bottom: 3px;
    height: 2px;
    border-radius: 2px;
    background: var(--gradient-brand);
  }
  [data-ready] > .indicator.is-on { opacity: 1; }

  @media (min-width: 860px) {
    .bar { grid-template-columns: 1fr auto 1fr; }
    .nav { display: block; }
  }

  /* ---------- Acciones ---------- */
  .actions { display: flex; align-items: center; gap: var(--space-2); justify-self: end; }
  .icon-btn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-pill);
    border: 0;
    background: transparent;
    color: var(--text);
    cursor: pointer;
    touch-action: manipulation;
    transition: background-color var(--duration-fast) var(--ease-out), transform var(--duration-base) var(--ease-spring);
  }
  .icon-btn:hover { background: var(--surface-raised); }
  .theme-toggle:active { transform: rotate(-24deg) scale(0.92); }
  .i-moon { display: none; }
  :global([data-scheme='light']) .i-sun { display: none; }
  :global([data-scheme='light']) .i-moon { display: block; }

  .contact-cta {
    display: none;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-6);
    border-radius: var(--radius-pill);
    background: var(--primary);
    color: var(--on-primary);
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
    touch-action: manipulation;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out),
      transform var(--duration-fast) var(--ease-spring);
  }
  .contact-cta:hover { background: var(--primary-hover); box-shadow: var(--shadow-glow); transform: translateY(-1px); }
  .contact-cta:active { transform: scale(0.97); }
  @media (min-width: 860px) { .contact-cta { display: inline-flex; } }

  .menu-btn { background: var(--surface-raised); }
  .burger { position: relative; width: 18px; height: 12px; display: block; }
  .burger span {
    position: absolute; left: 0; right: 0; height: 2px; border-radius: 2px; background: currentColor;
    transition: transform var(--duration-base) var(--ease-out);
  }
  .burger span:first-child { top: 1px; }
  .burger span:last-child { bottom: 1px; }
  [aria-expanded='true'] .burger span:first-child { transform: translateY(4px) rotate(45deg); }
  [aria-expanded='true'] .burger span:last-child { transform: translateY(-5px) rotate(-45deg); }
  @media (min-width: 860px) { .menu-btn { display: none; } }

  /* ---------- Progreso de lectura en los casos (sin JS) ---------- */
  .progress {
    position: absolute;
    left: 28px;
    right: 28px;
    bottom: -1px;
    height: 2px;
    border-radius: 2px;
    background: var(--gradient-brand);
    transform-origin: left;
    transform: scaleX(0);
    display: none;
  }
  @supports (animation-timeline: scroll()) {
    .progress { display: block; animation: read linear both; animation-timeline: scroll(root); }
    @keyframes read { to { transform: scaleX(1); } }
  }

  /* ---------- Menú móvil ---------- */
  .menu-panel {
    position: absolute;
    top: calc(100% + var(--space-2));
    left: 0;
    right: 0;
    padding: var(--space-4);
    border-radius: var(--radius-lg);
    background: color-mix(in oklab, var(--surface) 94%, transparent);
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-card);
    transform-origin: top center;
    animation: menu-in 220ms var(--ease-out);
  }
  .menu-panel[hidden] { display: none; }
  @keyframes menu-in { from { opacity: 0; transform: translateY(-6px) scale(0.98); } }
  .menu-panel ul { list-style: none; margin: 0; padding: 0; display: grid; }
  .menu-panel li + li { border-top: 1px solid var(--border); }
  .menu-panel ul a {
    display: flex;
    align-items: center;
    min-height: 56px;
    padding: 0 var(--space-2);
    font-family: var(--font-display);
    font-size: 1.5rem;
    text-decoration: none;
  }
  .menu-panel ul a[aria-current='page'] { color: var(--primary-text); }
  .menu-actions { display: grid; gap: var(--space-2); margin-top: var(--space-4); }
  @media (min-width: 860px) { .menu-panel { display: none !important; } }
</style>
