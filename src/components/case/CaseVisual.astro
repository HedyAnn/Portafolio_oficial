---
// Ilustración abstracta mientras no existan las pantallas con datos ficticios.
interface Props { variant: 'grid' | 'bars' | 'flow' | 'phone' | 'system' | 'dashboard' | 'scatter' | 'balance' | 'calendar' | 'brand' }
const { variant } = Astro.props;
---

<svg class="visual" viewBox="0 0 400 250" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <rect width="400" height="250" class="v-bg" />
  {variant === 'grid' && (
    <g>
      {Array.from({ length: 6 }, (_, r) =>
        Array.from({ length: 9 }, (_, c) => (
          <rect x={36 + c * 37} y={34 + r * 32} width="29" height="22" rx="6"
            class={(r * 9 + c) % 7 === 3 ? 'v-pri' : (r * 9 + c) % 5 === 1 ? 'v-acc' : 'v-soft'} />
        )),
      )}
    </g>
  )}
  {variant === 'bars' && (
    <g>
      {[0.42, 0.66, 0.54, 0.88, 0.72, 0.5, 0.95, 0.61].map((h, i) => (
        <rect x={44 + i * 42} y={210 - h * 160} width="26" height={h * 160} rx="8" class={i === 6 ? 'v-pri' : 'v-acc'} />
      ))}
      <path d="M40 118 C120 96, 200 126, 360 70" class="v-line" />
    </g>
  )}
  {variant === 'flow' && (
    <g>
      <path d="M40 50 C200 50, 200 120, 360 120 L360 160 C200 160, 200 90, 40 90 Z" class="v-pri v-op" />
      <path d="M40 110 C200 110, 200 40, 360 40 L360 70 C200 70, 200 140, 40 140 Z" class="v-acc v-op" />
      <path d="M40 160 C200 160, 200 190, 360 190 L360 215 C200 215, 200 185, 40 185 Z" class="v-acc v-op" />
      <rect x="28" y="44" width="12" height="148" rx="6" class="v-pri" />
      <rect x="360" y="34" width="12" height="187" rx="6" class="v-acc" />
    </g>
  )}
  {variant === 'phone' && (
    <g>
      <rect x="140" y="20" width="120" height="250" rx="28" class="v-card" />
      <rect x="158" y="52" width="84" height="56" rx="12" class="v-pri" />
      <rect x="158" y="122" width="84" height="12" rx="6" class="v-soft" />
      <rect x="158" y="144" width="60" height="12" rx="6" class="v-soft" />
      <rect x="158" y="174" width="84" height="36" rx="18" class="v-acc" />
      <circle cx="94" cy="80" r="26" class="v-acc v-op" />
      <circle cx="312" cy="170" r="34" class="v-pri v-op" />
    </g>
  )}
  {variant === 'system' && (
    <g>
      <rect x="40" y="40" width="96" height="40" rx="20" class="v-pri" />
      <rect x="148" y="40" width="96" height="40" rx="20" class="v-card" />
      <rect x="40" y="100" width="204" height="110" rx="20" class="v-card" />
      <rect x="264" y="40" width="96" height="170" rx="20" class="v-acc v-op" />
      <circle cx="80" cy="150" r="22" class="v-pri" />
      <rect x="118" y="138" width="100" height="10" rx="5" class="v-soft" />
      <rect x="118" y="156" width="70" height="10" rx="5" class="v-soft" />
    </g>
  )}
  {variant === 'dashboard' && (
    <g>
      <rect x="28" y="28" width="60" height="194" rx="12" class="v-card" />
      <rect x="40" y="46" width="36" height="8" rx="4" class="v-pri" />
      <rect x="40" y="66" width="30" height="8" rx="4" class="v-soft" />
      <rect x="40" y="86" width="34" height="8" rx="4" class="v-soft" />
      <rect x="100" y="28" width="82" height="52" rx="12" class="v-card" />
      <rect x="194" y="28" width="82" height="52" rx="12" class="v-card" />
      <rect x="288" y="28" width="84" height="52" rx="12" class="v-card" />
      <rect x="112" y="44" width="40" height="8" rx="4" class="v-acc" />
      <rect x="206" y="44" width="40" height="8" rx="4" class="v-pri" />
      <rect x="300" y="44" width="40" height="8" rx="4" class="v-acc" />
      <rect x="100" y="92" width="272" height="130" rx="12" class="v-card" />
      <path d="M118 196 C160 170, 190 186, 230 150 S310 120, 354 112" class="v-line" />
      <path d="M118 206 C170 196, 220 200, 354 168" class="v-line v-line-acc" />
    </g>
  )}
  {variant === 'scatter' && (
    <g>
      <path d="M48 210H360M48 210V36" class="v-axis" />
      {[[80,170],[104,150],[120,176],[140,128],[160,140],[178,112],[196,120],[214,96],[232,104],[252,80],[270,92],[290,70],[310,60],[330,74],[150,190],[220,160],[280,140]].map(([x,y],i) => (
        <circle cx={x} cy={y} r="8" class={i % 4 === 0 ? 'v-pri' : 'v-acc v-op'} />
      ))}
      <path d="M66 186 L340 58" class="v-line" />
    </g>
  )}
  {variant === 'balance' && (
    <g>
      <path d="M40 125H360" class="v-axis" />
      {[-46,30,-20,62,-70,18,44,-34].map((h,i) => (
        <rect x={56 + i * 38} y={h > 0 ? 125 - h : 125} width="24" height={Math.abs(h)} rx="7" class={h > 0 ? 'v-pri' : 'v-acc'} />
      ))}
    </g>
  )}
  {variant === 'calendar' && (
    <g>
      {Array.from({ length: 7 }, (_, c) => <rect x={40 + c * 46} y="30" width="38" height="14" rx="7" class="v-soft" />)}
      {[[0,0,3,'v-pri'],[1,1,2,'v-acc'],[2,0,2,'v-acc'],[3,2,3,'v-pri'],[4,1,3,'v-acc'],[5,0,2,'v-pri'],[6,3,2,'v-acc'],[0,4,1,'v-acc'],[2,3,2,'v-pri'],[4,4,1,'v-pri']].map(([c,r,h,cl]) => (
        <rect x={40 + Number(c) * 46} y={56 + Number(r) * 34} width="38" height={Number(h) * 34 - 8} rx="10" class={String(cl)} />
      ))}
    </g>
  )}
  {variant === 'brand' && (
    <g>
      <circle cx="140" cy="125" r="64" class="v-pri" />
      <circle cx="200" cy="125" r="64" class="v-acc v-op" />
      <rect x="282" y="70" width="70" height="26" rx="13" class="v-card" />
      <rect x="282" y="112" width="70" height="26" rx="13" class="v-pri" />
      <rect x="282" y="154" width="70" height="26" rx="13" class="v-acc" />
      <rect x="48" y="214" width="120" height="10" rx="5" class="v-soft" />
    </g>
  )}
</svg>

<style>
  .visual { width: 100%; height: 100%; }
  .v-bg { fill: var(--surface-raised); }
  .v-soft { fill: var(--border); }
  .v-card { fill: var(--surface); stroke: var(--border); }
  .v-pri { fill: var(--primary); }
  .v-acc { fill: var(--accent); }
  .v-op { opacity: 0.55; }
  .v-line { fill: none; stroke: var(--text); stroke-width: 2.5; stroke-linecap: round; opacity: 0.8; }
  .v-line-acc { stroke: var(--accent); }
  .v-axis { fill: none; stroke: var(--border-strong); stroke-width: 2; stroke-linecap: round; }
</style>
