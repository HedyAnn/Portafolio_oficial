---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import CaseVisual from './CaseVisual.astro';
import { withBase } from '../../site';

interface Props {
  entry: CollectionEntry<'cases'>;
  wide?: boolean;
  headingLevel?: 'h2' | 'h3';
}

const { entry, wide = false, headingLevel = 'h3' } = Astro.props;
const { title, summary, tags, origin, year, cover, coverAlt } = entry.data;
const Heading = headingLevel;
// El nombre de la empresa no aparece como marca en las tarjetas
const originLabel = origin === 'FollowUP' ? 'SaaS de analítica retail' : origin;
const variants = {
  'carga-de-metas': 'grid',
  'meta-justa': 'bars',
  'recorridos-multinivel': 'flow',
  'eat-japan': 'phone',
  'este-portafolio': 'system',
  'rediseno-plataforma-bi': 'dashboard',
  'clientes-por-vendedor': 'scatter',
  'control-dotacion': 'balance',
  'carga-de-turnos': 'calendar',
  'eat-japan-branding': 'brand',
} as const;
const variant = variants[entry.id as keyof typeof variants] ?? 'system';
---

<article class:list={['case-card', { wide }]}>
  <div class="media">
    {cover && coverAlt ? <Image src={cover} alt={coverAlt} width={960} loading="lazy" /> : <CaseVisual variant={variant} />}
  </div>
  <div class="body">
    <p class="meta">{originLabel}, {year}</p>
    <Heading class="title">
      <a href={withBase(`/casos/${entry.id}/`)}>{title}</a>
    </Heading>
    <p class="summary">{summary}</p>
    <ul class="tags">{tags.map((t) => <li class="tag">{t}</li>)}</ul>
  </div>
</article>

<style>
  .case-card {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-6);
    padding: var(--space-4);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-card);
    isolation: isolate;
    transition: transform var(--duration-base) var(--ease-out), box-shadow var(--duration-base) var(--ease-out);
  }
  @media (min-width: 640px) { .case-card { padding: var(--space-6); } }
  /* Borde degradado: aparece cuando la tarjeta responde al cursor o al foco */
  .case-card::before {
    content: '';
    position: absolute;
    inset: 0;
    padding: 1.5px;
    border-radius: inherit;
    background: var(--gradient-brand);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity var(--duration-base) var(--ease-out);
    pointer-events: none;
  }
  .case-card:hover, .case-card:focus-within { transform: translateY(-4px); box-shadow: var(--shadow-glow); }
  .case-card:hover::before, .case-card:focus-within::before { opacity: 1; }

  .media { aspect-ratio: 16 / 10; border-radius: var(--radius-md); overflow: hidden; background: var(--surface-raised); }
  .media :global(img), .media :global(svg) { width: 100%; height: 100%; object-fit: cover; transition: transform var(--duration-slow) var(--ease-out); }
  .case-card:hover .media :global(img), .case-card:hover .media :global(svg) { transform: scale(1.04); }

  .body { display: grid; gap: var(--space-3); align-content: start; }
  .meta { color: var(--text-subtle); font-size: 0.875rem; }
  .title { font-size: 1.375rem; line-height: 1.3; font-weight: 600; letter-spacing: -0.01em; }
  .title a { text-decoration: none; }
  /* Toda la tarjeta es clicable sin anidar enlaces */
  .title a::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .title a:focus-visible { outline: none; }
  .case-card:has(.title a:focus-visible) { outline: 2px solid var(--focus); outline-offset: 4px; }
  .summary { color: var(--text-muted); }
  .tags { margin-top: var(--space-1); }

  @media (min-width: 900px) {
    .wide { grid-template-columns: 1.35fr 1fr; align-items: center; gap: var(--space-12); padding: var(--space-8); }
    .wide .title { font-family: var(--font-display); font-weight: 450; font-size: 2.25rem; line-height: 1.12; letter-spacing: -0.015em; font-variation-settings: 'opsz' 72, 'SOFT' 100; }
    .wide .summary { font-size: 1.0625rem; }
  }
</style>
