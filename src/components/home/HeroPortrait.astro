---
// Hero editorial: la foto de Hedy en un marco de arco, rodeada de piezas de su proceso
// (post-it, cita de entrevista, flujo, prueba de usabilidad) unidas por trazos a mano.
// La foto se toma automáticamente de src/assets/hedy.(jpg|jpeg|png|webp). Si no existe, se muestra un marcador.
import '@fontsource-variable/caveat/index.css';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const found = import.meta.glob<{ default: ImageMetadata }>('../../assets/hedy.{jpg,jpeg,png,webp}', { eager: true });
const photo = Object.values(found)[0]?.default;

import type { Lang } from '../../i18n';
interface Props { lang?: Lang }
const { lang = 'es' } = Astro.props;
const c = {
  es: {
    alt: 'Hedy Herrada, Product Designer', placeholder: 'Espacio para la foto de Hedy Herrada', placeholderText: 'Tu foto va aquí',
    sticky: ['¿Qué problema resolvemos', 'y para quién?'], interview: 'Entrevista', quote: '“Necesito saber si mi tienda va a llegar a la meta.”',
    flow: ['Carga', 'Valida', 'Panel'], test: 'Prueba de usabilidad', done: 'Tarea completada', scribbles: ['discovery', 'investigación', 'validación'],
  },
  en: {
    alt: 'Hedy Herrada, Product Designer', placeholder: 'Placeholder for a photo of Hedy Herrada', placeholderText: 'Your photo goes here',
    sticky: ['What problem are we solving', 'and for whom?'], interview: 'Interview', quote: '“I need to know if my store will hit its goal.”',
    flow: ['Upload', 'Validate', 'Dashboard'], test: 'Usability test', done: 'Task completed', scribbles: ['discovery', 'research', 'validation'],
  },
}[lang];
---

<figure class="portrait" data-portrait>

  <div class="frame">
    {photo ? (
      <div class="cutout">
        <Image src={photo} alt={c.alt} widths={[360, 540, 720, 900]} sizes="(min-width: 960px) 440px, 85vw" loading="eager" fetchpriority="high" class="photo" />
      </div>
    ) : (
      <div class="placeholder" role="img" aria-label={c.placeholder}>
        <svg viewBox="0 0 32 32" width="72" height="72" aria-hidden="true">
          <path d="M10.5 9v14M21.5 9v14" fill="none" stroke="#fff" stroke-width="3.2" stroke-linecap="round" />
          <path d="M10.5 19.5c4 0 6.5-5.5 11-5.5" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" />
        </svg>
        <span>{c.placeholderText}</span>
      </div>
    )}
  </div>

  <svg class="sketch" viewBox="0 0 560 600" aria-hidden="true">
    <path class="trace t2" d="M392 258 C380 280, 368 292, 352 306" />
    <path class="head h2" d="M352 294 l0 13 13 -2" />
    <path class="trace t3" d="M96 452 C106 432, 118 420, 136 408" />
    <path class="head h3" d="M124 404 l12 4 -6 12" />
    <path class="trace t4" d="M444 478 C430 460, 414 448, 396 442" />
    <path class="head h4" d="M406 434 l-11 8 12 5" />
  </svg>

  <div class="note sticky" aria-hidden="true">
    <span class="hand">{c.sticky[0]}<br />{c.sticky[1]}</span>
  </div>

  <div class="note quote" aria-hidden="true">
    <span class="label">{c.interview}</span>
    <span class="quote-text">{c.quote}</span>
  </div>

  <div class="note flow" aria-hidden="true">
    <span class="label">User flow</span>
    <span class="flow-row">
      <span class="node">{c.flow[0]}</span><span class="arrow">→</span><span class="node">{c.flow[1]}</span><span class="arrow">→</span><span class="node on">{c.flow[2]}</span>
    </span>
  </div>

  <div class="note test" aria-hidden="true">
    <span class="check">
      <svg viewBox="0 0 18 18" width="18" height="18"><path d="M5 9.5l2.6 2.6L13 6.5" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </span>
    <span>
      <span class="label">{c.test}</span>
      <span class="test-text">{c.done}</span>
    </span>
  </div>

  <span class="hand scribble s-1" aria-hidden="true">{c.scribbles[0]}</span>
  <span class="hand scribble s-2" aria-hidden="true">{c.scribbles[1]}</span>
  <span class="hand scribble s-3" aria-hidden="true">{c.scribbles[2]}</span>
</figure>

<style>
  .portrait {
    --hand: 'Caveat Variable', 'Caveat', cursive;
    position: relative;
    margin: 0;
    width: 100%;
    max-width: 560px;
    aspect-ratio: 560 / 600;
    justify-self: center;
  }

  /* ---------- Marco de arco ---------- */
  .frame {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 64%;
    aspect-ratio: 3 / 4;
    transform: translate(-50%, -50%);
    border-radius: 999px 999px 28px 28px;
    padding: 6px;
    background: var(--gradient-brand);
    box-shadow: 0 30px 60px -24px color-mix(in oklab, var(--primary) 45%, transparent);
  }
  /* Con foto recortada: fondo suave en el arco y la cabeza sobresale por arriba */
  .frame:has(.cutout) {
    padding: 0;
    background:
      radial-gradient(80% 60% at 50% 18%, color-mix(in oklab, #fff 55%, transparent), transparent 70%),
      linear-gradient(170deg, color-mix(in oklab, var(--primary) 38%, var(--surface)), color-mix(in oklab, var(--accent) 45%, var(--surface)));
    outline: 2px solid color-mix(in oklab, var(--primary) 45%, transparent);
    outline-offset: 6px;
  }
  .cutout {
    position: absolute;
    inset: 0;
    /* recorta lados y base con la forma del arco, pero deja libre la parte de arriba */
    clip-path: inset(-30% 0 0 0 round 50% 50% 28px 28px / 42% 42% 28px 28px);
  }
  .cutout .photo {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: auto;
    height: 110%;
    max-width: none;
    transform: translateX(-50%);
    border-radius: 0;
    object-fit: contain;
    filter: drop-shadow(0 18px 24px rgb(40 10 40 / 0.25));
  }
  .photo, .placeholder {
    width: 100%;
    height: 100%;
    border-radius: 999px 999px 22px 22px;
    object-fit: cover;
    display: block;
  }
  .placeholder {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--space-3);
    background:
      radial-gradient(70% 60% at 50% 30%, color-mix(in oklab, #fff 18%, transparent), transparent 70%),
      linear-gradient(160deg, color-mix(in oklab, var(--primary) 70%, #2a0f2a), color-mix(in oklab, var(--accent) 75%, #1a103a));
    color: #fff;
    font-weight: 600;
    font-size: 0.875rem;
  }

  /* ---------- Trazos a mano ---------- */
  .sketch { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
  .trace, .head {
    fill: none;
    stroke: var(--primary-text);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 220;
    stroke-dashoffset: 220;
    animation: draw 900ms var(--ease-out) forwards;
  }
  .head { stroke-dasharray: 40; stroke-dashoffset: 40; }
  .t1, .h1 { animation-delay: 500ms; }
  .t2, .h2 { animation-delay: 680ms; }
  .t3, .h3 { animation-delay: 860ms; }
  .t4, .h4 { animation-delay: 1040ms; }
  @keyframes draw { to { stroke-dashoffset: 0; } }

  /* ---------- Piezas del proceso ---------- */
  .note {
    position: absolute;
    display: grid;
    gap: 4px;
    padding: var(--space-3) var(--space-4);
    border-radius: 14px;
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-card);
    font-size: 0.875rem;
    color: var(--text);
    opacity: 0;
    animation: pop 520ms var(--ease-spring) forwards;
    transition: transform var(--duration-base) var(--ease-spring), box-shadow var(--duration-base) var(--ease-out);
  }
  .note:hover { box-shadow: var(--shadow-glow); }
  .label { font-size: 0.75rem; font-weight: 600; color: var(--accent-text); }
  .hand { font-family: var(--hand); font-weight: 600; }

  .sticky {
    left: -10%;
    top: 4%;
    width: max-content;
    padding: var(--space-4);
    border: 0;
    border-radius: 6px 6px 18px 6px;
    background: color-mix(in oklab, var(--primary) 18%, #fff7c2);
    color: #3a2a12;
    --r: -5deg;
    transform: rotate(var(--r));
    animation-delay: 200ms;
  }
  .sticky .hand { font-size: 1.35rem; line-height: 1.1; }
  .quote { right: -6%; top: 30%; max-width: 220px; --r: 3deg; transform: rotate(var(--r)); animation-delay: 320ms; }
  .quote-text { font-family: var(--font-display); font-size: 1.05rem; line-height: 1.25; text-wrap: balance; }
  .flow { left: -8%; bottom: 13%; --r: -2deg; transform: rotate(var(--r)); animation-delay: 440ms; }
  .flow-row { display: flex; align-items: center; gap: 4px; }
  .node { padding: 3px 8px; border-radius: 999px; background: var(--surface-raised); font-size: 0.75rem; font-weight: 600; }
  .node.on { background: var(--primary); color: var(--on-primary); }
  .arrow { color: var(--text-subtle); font-size: 0.75rem; }
  .test { right: -6%; bottom: 9%; display: flex; align-items: center; gap: var(--space-3); --r: 2deg; transform: rotate(var(--r)); animation-delay: 560ms; }
  .test .label, .test-text { display: block; }
  .test-text { font-weight: 600; }
  .check { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: var(--success); flex: none; }
  .note:hover { transform: rotate(0deg) translateY(-3px); }

  .scribble { position: absolute; font-size: 1.3rem; line-height: 1; color: var(--primary-text); white-space: nowrap; opacity: 0; animation: fade 400ms ease forwards; }
  .s-1 { left: -6%; top: 25%; transform: rotate(-6deg); animation-delay: 1100ms; }
  .s-2 { right: -4%; top: 51%; transform: rotate(5deg); animation-delay: 1200ms; }
  .s-3 { right: -2%; bottom: 23%; transform: rotate(-4deg); animation-delay: 1300ms; }

  @keyframes pop { from { opacity: 0; transform: rotate(var(--r, 0deg)) translateY(12px) scale(0.92); } to { opacity: 1; transform: rotate(var(--r, 0deg)); } }
  @keyframes fade { to { opacity: 1; } }

  /* Profundidad: hero-fx.js mueve --px/--py (-1 a 1) con el cursor; cada capa se desplaza distinto */
  .frame { translate: calc(var(--px, 0) * -8px) calc(var(--py, 0) * -6px); }
  .sketch { translate: calc(var(--px, 0) * 6px) calc(var(--py, 0) * 5px); }
  .sticky { translate: calc(var(--px, 0) * 22px) calc(var(--py, 0) * 16px); }
  .quote { translate: calc(var(--px, 0) * 16px) calc(var(--py, 0) * 20px); }
  .flow { translate: calc(var(--px, 0) * 26px) calc(var(--py, 0) * 12px); }
  .test { translate: calc(var(--px, 0) * 18px) calc(var(--py, 0) * 22px); }
  .scribble { translate: calc(var(--px, 0) * 10px) calc(var(--py, 0) * 8px); }

  /* En reposo, las piezas flotan suavemente (individual property: no choca con su rotación) */
  @media (prefers-reduced-motion: no-preference) {
    .note { animation: pop 520ms var(--ease-spring) forwards, bob 6s ease-in-out 1.6s infinite; }
    .sticky { animation-delay: 200ms, 1.6s; }
    .quote { animation-duration: 520ms, 7s; animation-delay: 320ms, 2s; }
    .flow { animation-duration: 520ms, 6.5s; animation-delay: 440ms, 1.8s; }
    .test { animation-duration: 520ms, 5.5s; animation-delay: 560ms, 2.3s; }
  }
  @keyframes bob { 50% { margin-top: -6px; } }

  /* Móvil: menos piezas, más foto */
  @media (max-width: 640px) {
    .frame { width: 72%; }
    .flow, .scribble, .sketch { display: none; }
    .sticky { left: 0; width: max-content; padding: var(--space-3); }
    .quote { right: 0; }
    .test { right: 0; }
    .sticky .hand { font-size: 1.15rem; }
    .quote { max-width: 160px; top: 18%; }
    .quote-text { font-size: 0.95rem; }
    .test { bottom: 6%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .note, .scribble { opacity: 1; animation: none; }
    .trace, .head { stroke-dashoffset: 0; animation: none; }
  }
</style>
