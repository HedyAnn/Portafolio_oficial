---
// Hero interactivo: 150 puntos de datos sueltos que se ordenan en un gráfico de metas.
// Cada punto es un vendedor; cada columna, una tienda (datos ficticios).
// El script vive en /public/js/hero-units.js para cumplir la CSP (sin scripts en línea).
---

<figure class="units" data-units>
  <div class="stage">
    <canvas
      class="canvas"
      role="img"
      aria-label="Gráfico de 12 tiendas ficticias: 8 de 12 superan la meta. Se puede alternar entre los datos crudos y el gráfico ordenado."
    ></canvas>
    <button class="toggle" type="button" data-units-toggle data-ordered="true">
      <span class="dot" aria-hidden="true"></span>
      <span data-units-label>Ver los datos crudos</span>
    </button>
  </div>
</figure>
<script is:inline src="/js/hero-units.js" defer></script>

<style>
  .units { margin: 0; display: grid; gap: var(--space-4); }
  .stage {
    position: relative;
    aspect-ratio: 5 / 4;
    border-radius: var(--radius-lg);
    background:
      radial-gradient(90% 80% at 85% 10%, color-mix(in oklab, var(--primary) 16%, transparent), transparent 65%),
      radial-gradient(80% 70% at 0% 100%, color-mix(in oklab, var(--accent) 16%, transparent), transparent 60%),
      var(--surface);
    border: 1px solid var(--border);
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }
  .canvas { position: absolute; inset: 0; width: 100%; height: 100%; touch-action: pan-y; }
  .toggle {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 40px;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-pill);
    border: 1.5px solid var(--border-strong);
    background: color-mix(in oklab, var(--bg) 70%, transparent);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    color: var(--text);
    font: 600 0.875rem/1 var(--font-sans);
    cursor: pointer;
    transition: border-color var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-spring);
  }
  .toggle:hover { border-color: var(--primary); }
  .toggle:active { transform: scale(0.96); }
  .toggle .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--text-subtle);
    transition: background-color var(--duration-base) var(--ease-out), box-shadow var(--duration-base) var(--ease-out);
  }
  .toggle[data-ordered="true"] .dot { background: var(--primary); box-shadow: 0 0 0 4px color-mix(in oklab, var(--primary) 25%, transparent); }
</style>
