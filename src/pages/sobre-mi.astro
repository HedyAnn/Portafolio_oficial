---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site';

const path = [
  { when: '2026 – hoy', what: 'Product Designer UX/UI', where: 'SaaS de analítica para retail físico', note: 'Modelos de datos, especificaciones funcionales, dashboards y tareas de Product Owner.' },
  { when: 'Feb 2026', what: 'UX/UI Designer', where: 'SaaS de analítica para retail físico', note: 'Rediseño de la plataforma de BI: arquitectura de información, dashboards y sistema de diseño.' },
  { when: '2025 – 2026', what: 'Diplomado en Diseño UX/UI', where: 'Coderhouse', note: 'Proyecto EAT Japan: investigación, prototipo, pruebas de usabilidad y branding.' },
  { when: '2023 – 2025', what: 'Ciberseguridad y programación', where: 'UNAB, U. Autónoma, Talento Digital', note: 'Diplomado en Ciberseguridad, certificación ISC2 CC y bootcamp Full Stack Python.' },
];
---

<BaseLayout title="Sobre mí" description="Trayectoria y forma de trabajar de Hedy Herrada, Product Designer.">
  <section class="section">
    <div class="container about">
      <header class="head">
        <h1 class="display">Sobre mí</h1>
        <p class="lead">
          Soy Hedy, Product Designer en Santiago de Chile. Diseño productos de datos para retail: me gusta que una
          pantalla compleja se entienda sin manual y que una regla de negocio quede escrita antes de que alguien la
          programe.
        </p>
        <div class="cta-row">
          <a class="btn btn-primary" href={site.cv} download>{site.cvLabel}</a>
          {site.linkedin && <a class="btn btn-secondary" href={site.linkedin} target="_blank" rel="noopener noreferrer">Ver LinkedIn</a>}
        </div>
      </header>
      <section aria-labelledby="trayectoria">
        <h2 id="trayectoria" class="h2">Trayectoria</h2>
        <ol class="timeline">
          {path.map((p) => (
            <li>
              <p class="when">{p.when}</p>
              <h3 class="h3">{p.what}</h3>
              <p class="where">{p.where}</p>
              <p class="muted">{p.note}</p>
            </li>
          ))}
        </ol>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .about { display: grid; gap: var(--space-16); }
  .head { display: grid; gap: var(--space-6); max-width: 68ch; }
  .cta-row { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .timeline { list-style: none; margin: var(--space-8) 0 0; padding: 0 0 0 var(--space-6); border-left: 3px solid; border-image: var(--gradient-brand) 1; display: grid; gap: var(--space-8); }
  .timeline li { position: relative; display: grid; gap: var(--space-1); max-width: 60ch; }
  .timeline li::before { content: ''; position: absolute; left: calc(-1 * var(--space-6) - 9px); top: 6px; width: 15px; height: 15px; border-radius: 50%; background: var(--bg); border: 3px solid var(--primary); }
  .when { color: var(--primary-text); font-weight: 600; font-size: 0.9375rem; }
  .where { color: var(--text-muted); }
</style>
