---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../site';
---

<BaseLayout title="Página no encontrada">
  <section class="section">
    <div class="container head">
      <h1 class="display">Esta página no existe.</h1>
      <p class="lead">Puede que el enlace esté mal escrito o que el caso haya cambiado de dirección.</p>
      <div class="cta-row">
        <a class="btn btn-primary" href={withBase('/casos/')}>Ver proyectos</a>
        <a class="btn btn-quiet" href={withBase('/')}>Ir al inicio</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .head { display: grid; gap: var(--space-6); }
  .cta-row { display: flex; flex-wrap: wrap; gap: var(--space-3); }
</style>
