---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseCard from '../../components/case/CaseCard.astro';

const cases = (await getCollection('cases')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Proyectos" description="Proyectos de Product Design y UX/UI de Hedy Herrada.">
  <section class="section">
    <div class="container">
      <header class="head">
        <h1 class="display">Proyectos</h1>
        <p class="lead">Productos de datos, dashboards y procesos UX completos. Las pantallas usan datos ficticios.</p>
      </header>
      <div class="grid">
        {cases.map((entry) => <CaseCard entry={entry} headingLevel="h2" />)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .head { display: grid; gap: var(--space-4); margin-bottom: var(--space-12); }
  .grid { display: grid; gap: var(--space-8); }
  @media (min-width: 760px) { .grid { grid-template-columns: repeat(2, 1fr); } }
</style>
