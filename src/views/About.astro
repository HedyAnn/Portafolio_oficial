---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site';
import { ui, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const c = {
  es: {
    title: 'Sobre mí',
    description: 'Trayectoria y forma de trabajar de Hedy Herrada, Product Designer.',
    lead: 'Soy Hedy, Product Designer en Santiago de Chile. Diseño productos de datos para retail: interfaces complejas que se entienden sin manual y reglas de negocio documentadas antes de llegar a desarrollo.',
    pathTitle: 'Trayectoria',
    path: [
      { when: '2026 – hoy', what: 'Product Designer UX/UI', where: 'SaaS de analítica para retail', note: 'Modelos de datos, especificaciones funcionales y dashboards, con decisiones de alcance y prioridad.' },
      { when: 'Feb 2026', what: 'UX/UI Designer', where: 'SaaS de analítica para retail', note: 'Rediseño de la plataforma de BI: arquitectura de información, dashboards y sistema de diseño.' },
      { when: '2025 – 2026', what: 'Diplomado en Diseño UX/UI', where: 'Coderhouse', note: 'Proyecto EAT Japan: investigación, prototipo, pruebas de usabilidad y branding.' },
      { when: '2023 – 2025', what: 'Ciberseguridad y programación', where: 'UNAB, U. Autónoma, Talento Digital', note: 'Diplomado en Ciberseguridad, certificación ISC2 CC y bootcamp Full Stack Python.' },
    ],
  },
  en: {
    title: 'About',
    description: 'Background and way of working of Hedy Herrada, Product Designer.',
    lead: "I'm Hedy, a Product Designer based in Santiago, Chile. I design data products for retail: complex screens that make sense without a manual, and business rules documented before they reach development.",
    pathTitle: 'Background',
    path: [
      { when: '2026 – present', what: 'UX/UI Product Designer', where: 'Retail analytics SaaS', note: 'Data models, functional specifications and dashboards, with scope and priority decisions.' },
      { when: 'Feb 2026', what: 'UX/UI Designer', where: 'Retail analytics SaaS', note: 'BI platform redesign: information architecture, dashboards and design system.' },
      { when: '2025 – 2026', what: 'UX/UI Design Diploma', where: 'Coderhouse', note: 'EAT Japan project: research, prototype, usability testing and branding.' },
      { when: '2023 – 2025', what: 'Cybersecurity and programming', where: 'UNAB, U. Autónoma, Talento Digital', note: 'Cybersecurity Diploma, ISC2 CC certification and Full Stack Python bootcamp.' },
    ],
  },
}[lang];
---

<BaseLayout title={c.title} description={c.description}>
  <section class="section">
    <div class="container about">
      <header class="head">
        <h1 class="display">{c.title}</h1>
        <p class="lead">
          {c.lead}
        </p>
        <div class="cta-row">
          <a class="btn btn-primary" href={site.cv} download>{t.cvLong}</a>
          {site.linkedin && <a class="btn btn-secondary" href={site.linkedin} target="_blank" rel="noopener noreferrer">{t.linkedin}</a>}
        </div>
      </header>
      <section aria-labelledby="trayectoria">
        <h2 id="trayectoria" class="h2">{c.pathTitle}</h2>
        <ol class="timeline">
          {c.path.map((p) => (
            <li>
              <p class="when">{p.when}</p>
              <h3 class="h3">{p.what}</h3>
              <p class="where">{p.where}</p>
              <p class="muted">{p.note}</p>
            </li>
          ))}
        </ol>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .about { display: grid; gap: var(--space-16); }
  .head { display: grid; gap: var(--space-6); max-width: 68ch; }
  .cta-row { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .timeline { list-style: none; margin: var(--space-8) 0 0; padding: 0 0 0 var(--space-6); border-left: 3px solid; border-image: var(--gradient-brand) 1; display: grid; gap: var(--space-8); }
  .timeline li { position: relative; display: grid; gap: var(--space-1); max-width: 60ch; }
  .timeline li::before { content: ''; position: absolute; left: calc(-1 * var(--space-6) - 9px); top: 6px; width: 15px; height: 15px; border-radius: 50%; background: var(--bg); border: 3px solid var(--primary); }
  .when { color: var(--primary-text); font-weight: 600; font-size: 0.9375rem; }
  .where { color: var(--text-muted); }
</style>
