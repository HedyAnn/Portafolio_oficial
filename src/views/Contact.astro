---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site';
import { ui, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const c = {
  es: { title: 'Contacto', description: 'Contacto de Hedy Herrada, Product Designer.', lead: 'Escríbeme por correo para conversar sobre un rol o un proyecto. Respondo en uno o dos días hábiles.' },
  en: { title: 'Contact', description: 'Get in touch with Hedy Herrada, Product Designer.', lead: 'Email me to talk about a role or a project. I reply within one or two business days.' },
}[lang];
---

<BaseLayout title={c.title} description={c.description}>
  <section class="section">
    <div class="container head">
      <h1 class="display">{c.title}</h1>
      <p class="lead">{c.lead}</p>
      <p class="mail"><a class="link" href={`mailto:${site.email}`}>{site.email}</a></p>
      <ul class="channels">
        <li><a class="btn btn-secondary" href={site.cv} download>{t.cvLong}</a></li>
        {site.linkedin && <li><a class="btn btn-quiet" href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>}
        {site.behance && <li><a class="btn btn-quiet" href={site.behance} target="_blank" rel="noopener noreferrer">Behance</a></li>}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .head { display: grid; gap: var(--space-6); }
  .mail { font-family: var(--font-display); font-size: clamp(1.5rem, 4vw, 2.5rem); }
  .channels { display: flex; flex-wrap: wrap; gap: var(--space-3); list-style: none; margin: 0; padding: 0; }
</style>
