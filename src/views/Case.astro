---
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, withBase } from '../site';
import type { CaseEntry } from '../cases';
import { caseUrl, ui, url, type Lang } from '../i18n';

interface Props { lang: Lang; entry: CaseEntry; next?: CaseEntry }
const { lang, entry, next } = Astro.props;
const { title, summary, role, tools, year, origin, draft, behance, contexto, lead, imagenesReferenciales, cover, coverAlt, cover2, coverAlt2, cover3, coverAlt3, cover4, coverAlt4 } = entry.data;
const { Content } = await render(entry);
// Imágenes del caso; cada una tiene además una versión grande para verla ampliada
const covers = await Promise.all(
  ([[cover, coverAlt], [cover2, coverAlt2], [cover3, coverAlt3], [cover4, coverAlt4]] as const)
    .filter(([src, alt]) => src && alt)
    .map(async ([src, alt]) => ({ src: src!, alt: alt!, full: (await getImage({ src: src!, width: Math.min(src!.width, 2000), format: 'webp' })).src })),
);
const originLabel = ui[lang].origin[origin];
const c = {
  es: { crumbs: 'Ruta', projects: 'Proyectos', role: 'Rol', context: 'Contexto', tools: 'Herramientas', draft: 'Proyecto en redacción: el contenido final está en camino.', mockTitle: 'Imágenes referenciales.', mockText: 'Las pantallas de este caso son recreaciones con datos ficticios, no el producto real, para resguardar la confidencialidad de la plataforma y de sus clientes.', zoom: 'Ampliar imagen', close: 'Cerrar imagen ampliada', talk: 'Conversemos sobre este proyecto', next: 'Siguiente proyecto', behance: 'Ver proyecto completo en Behance', newTab: '(se abre en una pestaña nueva)' },
  en: { crumbs: 'Breadcrumb', projects: 'Projects', role: 'Role', context: 'Context', tools: 'Tools', draft: 'Case study in progress: the full write-up is on its way.', mockTitle: 'Reference images.', mockText: 'The screens in this case are recreations with fictional data, not the real product, to protect the confidentiality of the platform and its clients.', zoom: 'Enlarge image', close: 'Close enlarged image', talk: "Let's talk about this project", next: 'Next project', behance: 'See the full project on Behance', newTab: '(opens in a new tab)' },
}[lang];
---

<BaseLayout title={title} description={summary}>
  <article class="section case">
    <div class="container">
      <nav class="crumbs" aria-label={c.crumbs}>
        <a class="crumb-home" href={url('home', lang)} aria-label={ui[lang].crumbHome}>
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1h-4.5v-6h-5v6H5a1 1 0 0 1-1-1Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
        </a> / <a href={url('projects', lang)}>{c.projects}</a> / <span aria-current="page">{title}</span>
      </nav>
      <header class="case-head">
        <h1 class="h1">{title}</h1>
        <p class="lead">{lead ?? summary}</p>
        {imagenesReferenciales && (
          <p class="mock-note">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 3 4 6v6c0 4.4 3.4 8.3 8 9 4.6-.7 8-4.6 8-9V6Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M12 8v5M12 16h.01" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            <span><strong>{c.mockTitle}</strong> {c.mockText}</span>
          </p>
        )}
        {draft && <p class="draft">{c.draft}</p>}
        {behance && (
          <p class="case-link">
            <a class="btn btn-secondary" href={behance} target="_blank" rel="noopener noreferrer">
              {c.behance}
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M14 5h5v5M19 5l-8 8M18 14v4a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span class="visually-hidden">{c.newTab}</span>
            </a>
          </p>
        )}
      </header>
      <div class="case-body">
        <aside class:list={['case-aside', { 'has-two': covers.length > 1 }]}>
          {covers.map(({ src, alt, full }, i) => (
            <figure class="cover">
              <button type="button" class="zoom" data-zoom={full} aria-label={`${c.zoom}: ${alt}`} aria-haspopup="dialog">
                <Image src={src} alt={alt} widths={[480, 720, 960, 1280]} sizes="(min-width: 900px) 44vw, 94vw" loading={i === 0 ? 'eager' : 'lazy'} />
                <span class="zoom-hint" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="18" height="18"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M15.5 15.5 20 20M10.5 7.5v6M7.5 10.5h6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                </span>
              </button>
            </figure>
          ))}
          <dl class="ficha">
            <div><dt>{c.role}</dt><dd>{role.join(', ')}</dd></div>
            <div><dt>{c.context}</dt><dd>{contexto ?? `${originLabel}, ${year}`}</dd></div>
            {tools.length > 0 && <div><dt>{c.tools}</dt><dd>{tools.join(', ')}</dd></div>}
          </dl>
        </aside>
        <div class="prose">
          <Content />
        </div>
      </div>
      <footer class="case-foot">
        <a class="btn btn-primary" href={`mailto:${site.email}`}>{c.talk}</a>
        {next && next.id !== entry.id && <a class="btn btn-secondary" href={caseUrl(next.id, lang)}>{c.next}: {next.data.title}</a>}
      </footer>
    </div>
  </article>
  <dialog class="lightbox" data-lightbox aria-label={c.zoom}>
    <button type="button" class="lightbox-close" data-lightbox-close aria-label={c.close}>
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </button>
    <img data-lightbox-img alt="" />
  </dialog>
  <script is:inline src={withBase('/js/lightbox.js')} defer></script>
</BaseLayout>

<style>
  .crumbs { color: var(--text-subtle); font-size: 0.875rem; margin-bottom: var(--space-8); }
  .crumbs a { color: var(--text-muted); }
  .crumbs a:hover { color: var(--primary-text); }
  .crumb-home { display: inline-flex; vertical-align: -3px; padding: 2px; border-radius: var(--radius-sm); }
  .case { overflow-x: clip; }
  /* Encabezado: título y, debajo, el resumen a todo el ancho de la página */
  .case-head { display: grid; gap: var(--space-5); margin-bottom: var(--space-12); }
  .case-head .lead { max-width: none; }
  .case-link { margin: 0; }
  .case-link .btn { display: inline-flex; align-items: center; gap: var(--space-2); }
  @media (min-width: 900px) {
    .case-head .h1 { font-size: clamp(3rem, 3.6vw, 3.75rem); }
    .case-head .lead { font-size: 1.25rem; }
  }
  /* Cuerpo a dos columnas: portada y ficha a la izquierda, texto a la derecha */
  .case-body { display: grid; gap: var(--space-10); }
  .case-aside { display: grid; gap: var(--space-6); align-content: start; }
  @media (min-width: 900px) {
    .case-body { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr); gap: var(--space-12); align-items: start; }
    .case-body .prose { max-width: none; }
  }
  /* Las dos capturas ocupan el mismo ancho y la misma proporción */
  /* El fondo iguala el borde claro de las capturas, para que el redondeo se vea parejo */
  .case-aside .cover :global(img) { background: #f4f6f9; }
  .ficha { display: grid; gap: var(--space-4); margin: 0; padding: var(--space-6); border-radius: var(--radius-lg); background: var(--surface); }
  @media (min-width: 760px) { .ficha { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 900px) { .ficha { grid-template-columns: 1fr; gap: var(--space-5); } }
  .ficha dt { color: var(--text-subtle); font-size: 0.875rem; }
  .ficha dd { margin: var(--space-1) 0 0; font-weight: 500; }
  /* Imágenes ampliables */
  .zoom { position: relative; display: block; width: 100%; padding: 0; border: 0; background: none; border-radius: var(--radius-md); cursor: zoom-in; }
  .zoom:focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; }
  .zoom-hint { position: absolute; right: 0.6rem; bottom: 0.6rem; display: grid; place-items: center; width: 2.1rem; height: 2.1rem; border-radius: 999px; background: rgb(15 11 26 / 0.72); color: #fff; opacity: 0.85; transition: opacity var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out); }
  .zoom:hover .zoom-hint, .zoom:focus-visible .zoom-hint { opacity: 1; transform: scale(1.06); }
  .lightbox { width: min(96vw, 1600px); max-width: none; max-height: 94vh; padding: 0; border: 0; border-radius: var(--radius-lg); background: transparent; overflow: visible; }
  .lightbox::backdrop { background: rgb(8 6 15 / 0.86); }
  .lightbox img { display: block; width: 100%; height: auto; max-height: 94vh; object-fit: contain; border-radius: var(--radius-lg); background: #f4f6f9; }
  .lightbox-close { position: absolute; top: 0.6rem; right: 0.6rem; display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border: 0; border-radius: 999px; background: var(--surface-raised); color: var(--text); box-shadow: var(--shadow-card); cursor: pointer; }
  .lightbox-close:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  @media (prefers-reduced-motion: no-preference) {
    .lightbox[open] { animation: lb-in var(--duration-base) var(--ease-out); }
    @keyframes lb-in { from { opacity: 0; transform: scale(0.97); } to { opacity: 1; transform: none; } }
  }
  .mock-note { display: flex; gap: 0.75rem; align-items: flex-start; max-width: none; margin: 0; padding: 0.875rem 1rem; border: 1px solid var(--border); border-left: 3px solid var(--accent); border-radius: 12px; background: var(--surface); color: var(--text-muted); font-size: 0.9375rem; line-height: 1.5; }
  .mock-note svg { flex: none; margin-top: 0.15rem; color: var(--accent); }
  .mock-note strong { color: var(--text); }
  .draft { padding: var(--space-3) var(--space-4); border-radius: var(--radius-sm); border: 1px dashed var(--warning); color: var(--text-muted); font-size: 0.9375rem; }
  .cover { margin: 0; max-width: 680px; padding: var(--space-3); border-radius: var(--radius-lg); background: var(--surface); box-shadow: var(--shadow-card); }
  .cover :global(img) { display: block; width: 100%; height: auto; border-radius: var(--radius-md); }
  .prose :global(h2) { font-family: var(--font-display); font-weight: 450; font-size: 1.875rem; line-height: 1.2; }
  /* El primer título del texto arranca a la misma altura que la portada */
  .prose > :global(:first-child) { margin-top: 0; }
  .prose :global(h3) { font-size: 1.25rem; font-weight: 600; line-height: 1.3; margin-top: var(--space-8); }
  .prose :global(ul) { padding-left: 1.25rem; display: grid; gap: var(--space-3); }
  .prose :global(li::marker) { color: var(--primary-text); }
  .prose :global(strong) { color: var(--text); font-weight: 600; }
  .prose :global(p), .prose :global(li) { color: var(--text-muted); }
  .case-foot { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-16); padding-top: var(--space-8); border-top: 1px solid var(--border); }
</style>
