---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site';
import type { CaseEntry } from '../cases';
import { caseUrl, ui, url, type Lang } from '../i18n';

interface Props { lang: Lang; entry: CaseEntry; next?: CaseEntry }
const { lang, entry, next } = Astro.props;
const { title, summary, role, tools, year, origin, draft, cover, coverAlt, cover2, coverAlt2 } = entry.data;
const { Content } = await render(entry);
const originLabel = ui[lang].origin[origin];
const c = {
  es: { crumbs: 'Ruta', projects: 'Proyectos', role: 'Rol', context: 'Contexto', tools: 'Herramientas', draft: 'Proyecto en redacción: el contenido final está en camino.', talk: 'Conversemos sobre este proyecto', next: 'Siguiente proyecto' },
  en: { crumbs: 'Breadcrumb', projects: 'Projects', role: 'Role', context: 'Context', tools: 'Tools', draft: 'Case study in progress: the full write-up is on its way.', talk: "Let's talk about this project", next: 'Next project' },
}[lang];
---

<BaseLayout title={title} description={summary}>
  <article class="section case">
    <div class="container">
      <nav class="crumbs" aria-label={c.crumbs}><a href={url('projects', lang)}>{c.projects}</a> / <span aria-current="page">{title}</span></nav>
      <header class="case-head">
        <h1 class="h1">{title}</h1>
        <p class="lead">{summary}</p>
        {draft && <p class="draft">{c.draft}</p>}
      </header>
      <div class="case-body">
        <aside class:list={['case-aside', { 'has-two': cover2 && coverAlt2 }]}>
          {cover && coverAlt && (
            <figure class="cover">
              <Image src={cover} alt={coverAlt} widths={[480, 720, 960, 1280]} sizes="(min-width: 900px) 44vw, 94vw" loading="eager" />
            </figure>
          )}
          {cover2 && coverAlt2 && (
            <figure class="cover">
              <Image src={cover2} alt={coverAlt2} widths={[480, 720, 960, 1280]} sizes="(min-width: 900px) 44vw, 94vw" loading="lazy" />
            </figure>
          )}
          <dl class="ficha">
            <div><dt>{c.role}</dt><dd>{role.join(', ')}</dd></div>
            <div><dt>{c.context}</dt><dd>{originLabel}, {year}</dd></div>
            {tools.length > 0 && <div><dt>{c.tools}</dt><dd>{tools.join(', ')}</dd></div>}
          </dl>
        </aside>
        <div class="prose">
          <Content />
        </div>
      </div>
      <footer class="case-foot">
        <a class="btn btn-primary" href={`mailto:${site.email}`}>{c.talk}</a>
        {next && next.id !== entry.id && <a class="btn btn-secondary" href={caseUrl(next.id, lang)}>{c.next}: {next.data.title}</a>}
      </footer>
    </div>
  </article>
</BaseLayout>

<style>
  .crumbs { color: var(--text-subtle); font-size: 0.875rem; margin-bottom: var(--space-8); }
  .crumbs a { color: var(--text-muted); }
  .case { overflow-x: clip; }
  /* Encabezado: título y, debajo, el resumen a todo el ancho de la página */
  .case-head { display: grid; gap: var(--space-5); margin-bottom: var(--space-12); }
  .case-head .lead { max-width: none; }
  @media (min-width: 900px) {
    .case-head .h1 { font-size: clamp(3rem, 3.6vw, 3.75rem); }
    .case-head .lead { font-size: 1.25rem; }
  }
  /* Cuerpo a dos columnas: portada y ficha a la izquierda, texto a la derecha */
  .case-body { display: grid; gap: var(--space-10); }
  .case-aside { display: grid; gap: var(--space-6); align-content: start; }
  @media (min-width: 900px) {
    .case-body { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr); gap: var(--space-12); align-items: start; }
    .case-body .prose { max-width: none; }
  }
  /* Las dos capturas ocupan el mismo ancho y la misma proporción */
  /* El fondo iguala el borde claro de las capturas, para que el redondeo se vea parejo */
  .case-aside .cover :global(img) { aspect-ratio: 1432 / 906; object-fit: contain; background: #f4f6f9; }
  .ficha { display: grid; gap: var(--space-4); margin: 0; padding: var(--space-6); border-radius: var(--radius-lg); background: var(--surface); }
  @media (min-width: 760px) { .ficha { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 900px) { .ficha { grid-template-columns: 1fr; gap: var(--space-5); } }
  .ficha dt { color: var(--text-subtle); font-size: 0.875rem; }
  .ficha dd { margin: var(--space-1) 0 0; font-weight: 500; }
  .draft { padding: var(--space-3) var(--space-4); border-radius: var(--radius-sm); border: 1px dashed var(--warning); color: var(--text-muted); font-size: 0.9375rem; }
  .cover { margin: 0; max-width: 680px; padding: var(--space-3); border-radius: var(--radius-lg); background: var(--surface); box-shadow: var(--shadow-card); }
  .cover :global(img) { display: block; width: 100%; height: auto; border-radius: var(--radius-md); }
  .prose :global(h2) { font-family: var(--font-display); font-weight: 450; font-size: 1.875rem; line-height: 1.2; }
  /* El primer título del texto arranca a la misma altura que la portada */
  .prose > :global(:first-child) { margin-top: 0; }
  .prose :global(h3) { font-size: 1.25rem; font-weight: 600; line-height: 1.3; margin-top: var(--space-8); }
  .prose :global(ul) { padding-left: 1.25rem; display: grid; gap: var(--space-3); }
  .prose :global(li::marker) { color: var(--primary-text); }
  .prose :global(strong) { color: var(--text); font-weight: 600; }
  .prose :global(p), .prose :global(li) { color: var(--text-muted); }
  .case-foot { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-16); padding-top: var(--space-8); border-top: 1px solid var(--border); }
</style>
